# Kopyala: cp .env.example .env
# Ardından gerçek değerleri doldur.

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_REDIRECT_URL=http://localhost:8081/auth/callback

# Admin credentials are configured in Supabase Auth and local environment only.
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# AI / Asistan
GEMINI_API_KEY=your-gemini-api-key
LOVABLE_API_KEY=your-lovable-api-key
